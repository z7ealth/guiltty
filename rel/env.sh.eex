#!/bin/sh
# Sourced by bin/guiltty before every command. Only settings live here: the
# `guiltty` command you run is a small C client (c_src/client/guiltty.c)
# that asks the running guiltty for a window over a Unix socket, or runs
# `bin/guiltty daemon` when none is running (book chapter 23).

# Erlang distribution lets `guiltty stop`, `pid` and `remote` reach a
# running guiltty, and anyone who can connect to it can run code as you.
# So it's locked down (book chapter 20): the node is named after 127.0.0.1,
# listens only there (vm.args), and its cookie never appears on a command
# line (mix.exs, private_cookie/1). An epmd that guiltty has to start
# itself also listens only on 127.0.0.1.
RELEASE_NODE="${RELEASE_NODE:-guiltty@127.0.0.1}"
ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
export RELEASE_NODE ERL_EPMD_ADDRESS

case "$RELEASE_COMMAND" in
  start | start_iex | daemon | daemon_iex)
    # guiltty itself starts without a name, and takes it once it's free
    # (Guiltty.Distribution): an old guiltty may still hold it for a moment
    # while it shuts down, and a node started with -name would just fail.
    GUILTTY_NODE="$RELEASE_NODE"
    RELEASE_DISTRIBUTION=none
    export GUILTTY_NODE
    ;;
  *)
    # stop, pid, remote, rpc: short-lived nodes that connect to guiltty's.
    RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
    ;;
esac
export RELEASE_DISTRIBUTION

# Load each module the first time it's used (interactive), not every
# module of every application before starting (embedded, Mix's default):
# a cold start draws its first frame about 110 ms sooner (book chapter 22).
RELEASE_MODE="${RELEASE_MODE:-interactive}"
export RELEASE_MODE
