#!/bin/sh
# Sourced by bin/guiltty before every command. With no command (or "open"),
# it's the launcher: open a window on the running guiltty, starting it in
# the background first if it isn't running. The tabs live in that
# background node, so closing the window and running `guiltty` again brings
# them back.
case "${RELEASE_COMMAND:-open}" in
  open)
    bin="$RELEASE_ROOT/bin/$RELEASE_PROG"
    if "$bin" pid >/dev/null 2>&1; then
      # Running: ask it for a window, on this display.
      env64=$(env | grep -E '^(DISPLAY|WAYLAND_DISPLAY|XAUTHORITY|XDG_RUNTIME_DIR)=' | base64 -w0)
      "$bin" rpc "Guiltty.open_window(env64: \"$env64\")" >/dev/null 2>&1 && exit 0
      # It answered, but couldn't open a window: it's shutting down (its
      # last window was just closed). Wait until it's gone, then start a
      # new one: two nodes can't share the name.
      tries=0
      while "$bin" pid >/dev/null 2>&1; do
        tries=$((tries + 1))
        if [ "$tries" -gt 20 ]; then
          echo "guiltty: the running guiltty isn't answering" >&2
          exit 1
        fi
        sleep 0.25
      done
    fi
    # Not running: start it, and that's all. The node opens its first
    # window as it boots, on this display (it inherits DISPLAY and the
    # rest).
    exec "$bin" daemon
    ;;
esac
